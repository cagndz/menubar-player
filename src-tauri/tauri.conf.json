{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Menubar Player",
  "version": "0.1.0",
  "identifier": "com.cagndz.menubar-player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Menubar Player",
        "width": 320,
        "height": 400,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "backgroundThrottling": "disabled",
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "media-src": "https://*.googlevideo.com",
        "connect-src": "ipc: http://ipc.localhost"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "copyright": "© 2026 Carlos Agúndez",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
